---
interface Props {
  command: string
  class?: string
}

const { command, class: className = '' } = Astro.props
---

<div
  class:list={[
    'flex items-center gap-3 rounded-full border border-[var(--rule)] bg-[var(--surface)] py-2 pl-5 pr-2',
    className,
  ]}
>
  {/* min-w-0 lets this shrink below its content so its own overflow-x-auto scrolls
     instead of the flex item forcing the whole pill (and the page) wider. */}
  <code
    class="command-text min-w-0 overflow-x-auto whitespace-nowrap font-mono text-[13px] text-[var(--fg)]"
    >{command}</code
  >
  <button
    type="button"
    class="copy-command shrink-0 rounded-full px-3 py-1.5 font-mono text-xs font-medium text-[var(--fg-soft)] transition hover:bg-[color-mix(in_srgb,var(--fg)_8%,transparent)] hover:text-[var(--fg)]"
    data-command={command}
    aria-live="polite"
    aria-label={`Copy "${command}" to the clipboard`}
  >
    copy
  </button>
</div>

<style>
  /* The pill is too narrow for the install command on a phone. It has always
     scrolled, but with a hard edge it just looked like a truncated string, so
     the end of the command read as missing rather than reachable. These masks
     fade whichever edge still has content behind it. */
  .command-text {
    scrollbar-width: none;
  }

  .command-text::-webkit-scrollbar {
    display: none;
  }

  .command-text[data-more='end'] {
    mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent 100%);
  }

  .command-text[data-more='start'] {
    mask-image: linear-gradient(to right, transparent 0, #000 2rem);
  }

  .command-text[data-more='both'] {
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 2rem,
      #000 calc(100% - 2rem),
      transparent 100%
    );
  }
</style>

<script>
  /**
   * Marks which edges of the command still have content behind them, and makes
   * the region keyboard-scrollable only while it actually overflows — a
   * permanent tab stop on a pill that fits would be a stop that does nothing.
   */
  function syncOverflow(el: HTMLElement) {
    const scrollable = el.scrollWidth - el.clientWidth

    if (scrollable <= 1) {
      el.removeAttribute('data-more')
      el.removeAttribute('tabindex')
      return
    }

    const atStart = el.scrollLeft <= 1
    const atEnd = el.scrollLeft >= scrollable - 1
    el.dataset.more = atStart ? 'end' : atEnd ? 'start' : 'both'
    el.tabIndex = 0
  }

  for (const el of document.querySelectorAll<HTMLElement>('.command-text')) {
    syncOverflow(el)
    el.addEventListener('scroll', () => syncOverflow(el), { passive: true })
    new ResizeObserver(() => syncOverflow(el)).observe(el)
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.copy-command')) {
    button.addEventListener('click', async () => {
      const command = button.dataset.command
      if (!command) return
      try {
        await navigator.clipboard.writeText(command)
        button.textContent = 'copied'
      } catch {
        button.textContent = 'press ⌘C'
      }
      setTimeout(() => {
        button.textContent = 'copy'
      }, 1800)
    })
  }
</script>
